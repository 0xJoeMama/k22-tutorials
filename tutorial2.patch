diff --git a/kernel/k22hello.c b/kernel/k22hello.c
new file mode 100644
index 000000000000..ae0faa99c037
--- /dev/null
+++ b/kernel/k22hello.c
@@ -0,0 +1,64 @@
+#include <linux/printk.h>
+#include <linux/overflow.h>
+#include <linux/types.h>
+#include <linux/syscalls.h>
+
+static const char HELLO[] = "Hello ";
+
+static int k22hello(const char __user *input, size_t in_sz, char __user *output,
+		    size_t out_sz)
+{
+	int ret = 0;
+	size_t kbuf_sz = 0, written = 0;
+	char *kbuf = NULL;
+
+	printk("k22 says hello\n");
+
+	// check that we do not get arithmetic overflow
+	if (check_add_overflow(in_sz, sizeof(HELLO), &kbuf_sz)) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	// check that the output buffer is at LEAST enough for us to copy everything into
+	if (out_sz < kbuf_sz) {
+		ret = -ENOBUFS;
+		goto out;
+	}
+
+	// allocate a buffer inside the kernel
+	kbuf = kmalloc(kbuf_sz, GFP_KERNEL);
+	if (!kbuf) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	// use strscpy instead of strcpy because strcpy instructs us to use this instead
+	// _pad also inserts 0 on the rest of the string
+	written = strscpy_pad(kbuf, HELLO, kbuf_sz);
+
+	// check docs of strscpy_pad to see what it returns
+	if (copy_from_user(kbuf + written, input, in_sz)) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	// technically not needed since we use strscpy_pad
+	// kbuf[kbuf_sz - 1] = '\0';
+
+	// copy at most kbuf_sz into the output buffer
+	if (copy_to_user(output, kbuf, kbuf_sz)) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+out:
+	kfree(kbuf);
+	return ret;
+}
+
+SYSCALL_DEFINE4(k22hello, const char __user *, input, size_t, in_sz,
+		char __user *, output, size_t, out_sz)
+{
+	return k22hello(input, in_sz, output, out_sz);
+}
